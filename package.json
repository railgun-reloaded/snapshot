{
  "name": "@railgun-reloaded/snapshot",
  "version": "1.0.0",
  "description": "A package to create snapshot of railgun events for data-sync",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./node": {
      "types": "./src/node/index.d.ts",
      "default": "./src/node/index.js"
    }
  },
  "imports": {
    "#snapshot-brotli": {
      "browser": "./src/snapshot/brotli-browser.js",
      "node": "./src/snapshot/brotli-node.js",
      "default": "./src/snapshot/brotli-browser.js"
    }
  },
  "scripts": {
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "pretest": "npm run build",
    "test": "NODE_OPTIONS=--enable-source-maps node --test 'test/**/*.test.js'",
    "test:generate-events-dump": "cd scripts && npx tsx dump-events.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/railgun-reloaded/snapshot.git"
  },
  "keywords": [
    "railgun",
    "railgun-reloaded",
    "snapshot"
  ],
  "author": "RAILGUN Project Contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/railgun-reloaded/snapshot/issues"
  },
  "homepage": "https://github.com/railgun-reloaded/snapshot#readme",
  "dependencies": {
    "@ipld/car": "^5.3.3",
    "@ipld/dag-cbor": "^9.2.5",
    "@railgun-reloaded/scanner": "https://github.com/railgun-reloaded/scanner.git#dev",
    "@railgun-reloaded/subsquid-client": "https://github.com/railgun-reloaded/subsquid-client.git#master",
    "brotli-wasm": "^3.0.1",
    "cborg": "^5.1.1",
    "dotenv": "^17.2.3",
    "multiformats": "^14.0.0"
  },
  "devDependencies": {
    "@railgun-reloaded/eslint-config": "^1.1.0",
    "@railgun-reloaded/tsconfig": "^1.2.0",
    "@types/node": "^24.7.2",
    "typescript": "^5.9.3"
  }
}
